---
const { title, img, desc, url, badge, tags, target = "_blank", tagBase } = Astro.props;
const resolvedTagBase =
  tagBase ??
  `${url
    .replace(/\/+$/, "")
    .split("/")
    .slice(0, -1)
    .join("/")}/tag`;
---

<div class="rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%]">
  <div class="hero-content flex-col md:flex-row">
    {
      img && (
        <a href={url} target={target} rel={target === "_blank" ? "noopener noreferrer" : undefined}>
          <img
            src={img}
            width="750"
            height="422"
            alt={title}
            class="max-w-full md:max-w-[13rem] rounded-lg"
            loading="lazy"
          />
        </a>
      )
    }
    <div class="grow w-full">
      <h1 class="text-xl font-bold">
        <a href={url} target={target} rel={target === "_blank" ? "noopener noreferrer" : undefined} class="hover:underline">
          {title}
        </a>
        {badge && <span class="badge badge-secondary mx-2">{badge}</span>}
      </h1>
      <p class="py-1 text-1xl">{desc}</p>
      <div class="card-actions justify-end">
        {
          tags &&
            tags.map((tag: string) => (
              <a href={`${resolvedTagBase}/${encodeURIComponent(tag)}/`} class="badge badge-outline">
                {tag}
              </a>
            ))
        }
      </div>
    </div>
  </div>
</div>
