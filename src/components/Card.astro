---
const { title, img, desc, url, badge, tags, target = "_blank" } = Astro.props;
---

<div class="md:w-1/3 w-full">
  <a href={url} target={target} rel={target === "_blank" ? "noopener noreferrer" : undefined}>
    <div class="card bg-base-100 transition ease-in-out hover:shadow-xl mx-6 my-2 hover:scale-[102%]">
      {img && <img width="750" height="422" src={img} alt={title} loading="lazy" />}
      <div class="card-body">
        <h2 class="card-title">
          {title}
          {badge && <span class="badge badge-secondary">{badge}</span>}
        </h2>
        <p>{desc}</p>
        <div class="card-actions justify-end">
          {tags && tags.map((tag: string) => <span class="badge badge-outline">{tag}</span>)}
        </div>
      </div>
    </div>
  </a>
</div>
