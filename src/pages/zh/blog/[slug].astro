---
import { render } from "astro:content";
import PostLayout from "../../../layouts/PostLayout.astro";
import { getPostSlug, getPostsByLocale, getTranslationPath } from "../../../lib/blog";

export async function getStaticPaths() {
  const posts = await getPostsByLocale("zh");
  return posts.map((entry) => ({
    params: { slug: getPostSlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const translationPath = await getTranslationPath(entry, "en");
---

<PostLayout
  title={entry.data.title}
  description={entry.data.description}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  heroImage={entry.data.heroImage}
  badge={entry.data.badge}
  tags={entry.data.tags}
  locale="zh"
  translationPath={translationPath}
>
  <Content />
</PostLayout>
