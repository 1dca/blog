---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SideBar from "../components/SideBar.astro";
import { ClientRouter } from "astro:transitions";
import { SITE, TRANSITION_API } from "../config";
import type { Locale } from "../i18n/locales";
import { htmlLang } from "../i18n/locales";
import { alternateLocalePath } from "../i18n/utils";

const {
  image,
  title = SITE.title.en,
  description = SITE.description.en,
  includeSidebar = true,
  sideBarActiveItemID,
  ogType,
  locale = "en",
  translationPath = undefined,
  alternateUrl: alternateUrlProp = undefined,
} = Astro.props as {
  image?: string;
  title?: string;
  description?: string;
  includeSidebar?: boolean;
  sideBarActiveItemID?: string;
  ogType?: string;
  locale?: Locale;
  translationPath?: string | null;
  alternateUrl?: string | null;
};

const alternateUrl =
  alternateUrlProp !== undefined
    ? alternateUrlProp
    : alternateLocalePath(locale, Astro.url.pathname, { translationPath });
---

<!doctype html>
<html lang={htmlLang[locale]} data-theme="lofi">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      ogType={ogType}
      locale={locale}
      alternateUrl={alternateUrl}
    />
    {TRANSITION_API && <ClientRouter />}
  </head>
  <body>
    <div class="bg-base-100 drawer lg:drawer-open">
      <input id="my-drawer" type="checkbox" class="drawer-toggle" />
      <div class="drawer-content bg-base-100">
        <Header locale={locale} />
        <div class="md:flex md:justify-center">
          <main class="p-6 pt-10 lg:max-w-[900px] max-w-[100vw]">
            <slot />
          </main>
        </div>
        <Footer locale={locale} />
      </div>
      {
        includeSidebar && (
          <SideBar
            sideBarActiveItemID={sideBarActiveItemID}
            locale={locale}
            alternateUrl={alternateUrl}
          />
        )
      }
    </div>
  </body>
</html>
