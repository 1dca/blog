---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config";
import { about } from "../data/resume";
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/ui";
import { localePath } from "../i18n/utils";

const { locale } = Astro.props as { locale: Locale };
const pageTitle = t(locale, "about");
---

<BaseLayout
  locale={locale}
  title={`${pageTitle} | ${SITE.author[locale]}`}
  description={about.lead[locale]}
  sideBarActiveItemID="about"
  alternateUrl={localePath(locale === "en" ? "zh" : "en", "/about")}
>
  <div class="pb-4">
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4">{pageTitle}</h1>
    <p class="text-lg md:text-xl leading-relaxed opacity-90 max-w-prose">
      {about.lead[locale]}
    </p>
  </div>

  <div class="divider my-6"></div>

  {
    about.sections.map((section) => (
      <section class="mb-10">
        <h2 class="text-2xl font-semibold mb-3">{section.title[locale]}</h2>
        <p class="text-base md:text-lg leading-relaxed opacity-90 max-w-prose">
          {section.body[locale]}
        </p>
      </section>
    ))
  }

  <section class="mb-4">
    <h2 class="text-2xl font-semibold mb-4">{t(locale, "currentlyInto")}</h2>
    <div class="flex flex-wrap gap-2">
      {
        about.into[locale].map((item) => (
          <span class="badge badge-outline badge-lg py-3 px-4 font-normal">{item}</span>
        ))
      }
    </div>
  </section>
</BaseLayout>
