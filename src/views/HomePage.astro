---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { SITE } from "../config";
import { getFeaturedProjects } from "../data/projects";
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/ui";
import { blogPostPath, localePath } from "../i18n/utils";
import { getPostSlug, getPostsByLocale } from "../lib/blog";

const { locale } = Astro.props as { locale: Locale };
const posts = await getPostsByLocale(locale);
const lastPosts = posts.slice(0, 3);
const featured = getFeaturedProjects();
---

<BaseLayout
  locale={locale}
  sideBarActiveItemID="home"
  title={SITE.title[locale]}
  description={SITE.description[locale]}
  alternateUrl={localePath(locale === "en" ? "zh" : "en", "/")}
>
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">{locale === "en" ? "Hey there 👋" : "你好 👋"}</div>
    <div class="text-5xl font-bold">{SITE.author[locale]}</div>
    <div class="text-3xl py-3 font-bold">{SITE.tagline[locale]}</div>
    <div class="py-2">
      <p class="text-lg">{SITE.intro[locale]}</p>
    </div>
    <div class="mt-8">
      <a class="btn" href={`mailto:${SITE.email}`}>{t(locale, "connect")}</a>
      <a
        href={SITE.socials.github}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-outline ml-5">{t(locale, "viewGithub")}</a
      >
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">{t(locale, "latestProjects")} {"</>"}</div>
  </div>

  {
    featured.map((project, index) => (
      <>
        {index > 0 && <div class="divider my-0" />}
        <HorizontalCard
          title={project.title[locale]}
          img={project.image}
          desc={project.description[locale]}
          url={project.url}
          badge={project.badge?.[locale]}
        />
      </>
    ))
  }

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">{t(locale, "latestBlog")}</div>
  </div>

  {
    lastPosts.map((post, index) => (
      <>
        {index > 0 && <div class="divider my-0" />}
        <HorizontalCard
          title={post.data.title}
          img={post.data.heroImage}
          desc={post.data.description}
          url={blogPostPath(locale, getPostSlug(post))}
          target="_self"
          badge={post.data.badge}
          tags={post.data.tags}
          tagBase={localePath(locale, "/blog/tag")}
        />
      </>
    ))
  }
</BaseLayout>
