---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { SITE } from "../config";
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/ui";
import { blogPostPath, localePath } from "../i18n/utils";
import { getPostSlug } from "../lib/blog";

const { locale, page, heading } = Astro.props as {
  locale: Locale;
  page: {
    data: any[];
    url: { prev?: string; next?: string };
  };
  heading: string;
};
---

<BaseLayout
  locale={locale}
  title={`${heading} | ${SITE.author[locale]}`}
  description={SITE.description[locale]}
  sideBarActiveItemID="blog"
  alternateUrl={localePath(locale === "en" ? "zh" : "en", "/blog/")}
>
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">{heading}</div>
  </div>

  {
    page.data.length === 0 ? (
      <div class="bg-base-200 border-l-4 border-secondary w-full p-4 min-w-full">
        <p class="font-bold">{t(locale, "blogEmptyTitle")}</p>
        <p>{t(locale, "blogEmptyBody")}</p>
      </div>
    ) : (
      <ul>
        {page.data.map((post: any, index: number) => (
          <>
            {index > 0 && <div class="divider my-0" />}
            <HorizontalCard
              title={post.data.title}
              img={post.data.heroImage}
              desc={post.data.description}
              url={blogPostPath(locale, getPostSlug(post))}
              target="_self"
              badge={post.data.badge}
              tags={post.data.tags}
              tagBase={localePath(locale, "/blog/tag")}
            />
          </>
        ))}
      </ul>
    )
  }

  <div class="flex justify-between">
    {
      page.url.prev ? (
        <a href={page.url.prev} class="btn btn-ghost my-10 mx-5">
          <svg class="h-6 w-6 fill-current md:h-8 md:w-8" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
            <path d="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" />
          </svg>
          {t(locale, "recentPosts")}
        </a>
      ) : (
        <div />
      )
    }
    {
      page.url.next ? (
        <a href={page.url.next} class="btn btn-ghost my-10 mx-5">
          {t(locale, "olderPosts")}
          <svg class="h-6 w-6 fill-current md:h-8 md:w-8" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
            <path d="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" />
          </svg>
        </a>
      ) : (
        <div />
      )
    }
  </div>
</BaseLayout>
