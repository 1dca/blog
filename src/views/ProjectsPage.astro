---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { SITE } from "../config";
import { projects } from "../data/projects";
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/ui";
import { localePath } from "../i18n/utils";

const { locale } = Astro.props as { locale: Locale };
---

<BaseLayout
  locale={locale}
  title={`${t(locale, "projects")} | ${SITE.author[locale]}`}
  description={SITE.description[locale]}
  sideBarActiveItemID="projects"
  alternateUrl={localePath(locale === "en" ? "zh" : "en", "/projects")}
>
  <div>
    <div class="text-3xl w-full font-bold mb-5">{t(locale, "projectsHeader")}</div>
  </div>

  {
    projects.map((project, index) => (
      <>
        {index > 0 && <div class="divider my-0" />}
        <HorizontalCard
          title={project.title[locale]}
          img={project.image}
          desc={project.description[locale]}
          url={project.url}
          badge={project.badge?.[locale]}
        />
      </>
    ))
  }
</BaseLayout>
